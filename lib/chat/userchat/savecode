class UserListScreen extends StatelessWidget {
  final String currentUserId;
  final ChatUserController controller = Get.put(ChatUserController());

  UserListScreen({required this.currentUserId});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: Paints().chatbg(),
      appBar: AppBarCustom(
        title: 'Chat',
        textColor: Paints().chattext(),
        backgroundColor: Paints().chatbg(),
        elevation: 0.5,
        leading: () {
          Get.back();
        },
      ),
      body: StreamBuilder<QuerySnapshot>(
        stream: FirebaseFirestore.instance
            .collection('Users')
            .where(FieldPath.documentId, isNotEqualTo: currentUserId)
            .snapshots(),
        builder: (context, snapshot) {
          if (!snapshot.hasData) {
            return const Center(child: CircularProgressIndicator());
          }

          final users = snapshot.data!.docs;

          // ดึงข้อมูลข้อความล่าสุดพร้อมกับเรียงลำดับ
          return FutureBuilder<List<Map<String, dynamic>>>(
            future: _getSortedChatList(users),
            builder: (context, sortedSnapshot) {
              if (!sortedSnapshot.hasData) {
                return const Center(child: CircularProgressIndicator());
              }

              final sortedUsers = sortedSnapshot.data!;

              return ListView.builder(
                physics: const BouncingScrollPhysics(),
                itemCount: sortedUsers.length,
                itemBuilder: (context, index) {
                  var item = sortedUsers[index];
                  var user = item['user'];
                  var latestMessage = item['latestMessage'];

                  return InkWell(
                    onTap: () async {
                      String chatRoomId = await controller.createChatRoom(
                          currentUserId, user.id);

                      Get.to(
                        () => ChatUserView(
                          chatId: chatRoomId,
                          currentUserId: currentUserId,
                          recipientUserId: user.id,
                          nameUser: user['username'][Lang.real],
                          emailUser: user['email'],
                          imgUser: '${controller.urlportal}/${user['img']}',
                        ),
                      );
                    },
                    child: Padding(
                      padding: const EdgeInsets.symmetric(
                          vertical: 8, horizontal: 16),
                      child: Row(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          CircleAvatar(
                            backgroundImage: NetworkImage(
                                '${controller.urlportal}/${user['img']}'),
                            backgroundColor: Paints.transparent,
                            radius: 25,
                          ),
                          const SizedBox(width: 12),
                          Expanded(
                            child: Column(
                              crossAxisAlignment: CrossAxisAlignment.start,
                              children: [
                                Labels.custom(
                                  user['username'][Lang.real] ?? "Unknown User",
                                  color: Paints().chattext(),
                                  maxLines: 1,
                                  maxSize: 14,
                                  minSize: 12,
                                  weight: latestMessage != null
                                      ? (currentUserId !=
                                                  latestMessage.senderId &&
                                              !latestMessage.isRead)
                                          ? FontWeight.bold
                                          : FontWeight.w400
                                      : FontWeight.w400,
                                  overflow: TextOverflow.ellipsis,
                                ),
                                if (latestMessage != null)
                                  Row(
                                    children: [
                                      if (currentUserId ==
                                          latestMessage.senderId)
                                        Icon(
                                            Icons
                                                .subdirectory_arrow_right_rounded,
                                            size: 12,
                                            color: Paints.dark500),
                                      const SizedBox(width: 3),
                                      Expanded(
                                        child: Labels.custom(
                                          latestMessage.text,
                                          color: (currentUserId !=
                                                      latestMessage.senderId &&
                                                  !latestMessage.isRead)
                                              ? Paints().chattext()
                                              : Paints().chatfont(),
                                          weight: (currentUserId !=
                                                      latestMessage.senderId &&
                                                  !latestMessage.isRead)
                                              ? FontWeight.bold
                                              : FontWeight.w300,
                                          overflow: TextOverflow.ellipsis,
                                          maxLines: 1,
                                          maxSize: 11,
                                          minSize: 10,
                                        ),
                                      ),
                                    ],
                                  ),
                              ],
                            ),
                          ),
                          if (latestMessage != null)
                            Labels.custom(
                              Formatdate().formatDate(latestMessage.timestamp),
                              color: Paints().chatfont(),
                              maxSize: 10,
                              minSize: 9,
                              weight: FontWeight.w200,
                            ),
                        ],
                      ),
                    ),
                  );
                },
              );
            },
          );
        },
      ),
    );
  }

  // ฟังก์ชันดึงและเรียงข้อมูลแชท
  Future<List<Map<String, dynamic>>> _getSortedChatList(
      List<QueryDocumentSnapshot> users) async {
    List<Future<Map<String, dynamic>>> futures = users.map((userDoc) async {
      final user = userDoc.data() as Map<String, dynamic>;
      List<String> usersList = [currentUserId, userDoc.id];
      usersList.sort();
      String chatId = usersList.join('_');

      UserMessage? latestMessage =
          await controller.getLatestMessage(chatId).first;
      return {
        'user': user,
        'latestMessage': latestMessage,
      };
    }).toList();

    List<Map<String, dynamic>> userList = await Future.wait(futures);

    // เรียงลำดับตาม `timestamp` ล่าสุด
    userList.sort((a, b) {
      DateTime? dateA = a['latestMessage']?.timestamp;
      DateTime? dateB = b['latestMessage']?.timestamp;

      if (dateA == null && dateB == null) return 0;
      if (dateA == null) return 1;
      if (dateB == null) return -1;

      return dateB.compareTo(dateA);
    });

    return userList;
  }
}



