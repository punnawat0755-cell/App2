                                      child: Row(
                                        children: [
                                          const Icon(Icons.copy_rounded,
                                              color: Colors.black),
                                          const SizedBox(width: 5),
                                          Expanded(
                                            child: Text(
                                              'คัดลอกข้อความ',
                                              style: Labels.fonts(
                                                  fontSize: 12,
                                                  FontWeight.w400,
                                                  Colors.black),
                                            ),
                                          ),
                                        ],
                                      ),
                                    ),
                                    if (isMe) ...[
                                      PopupMenuItem(
                                        value: 'delete',
