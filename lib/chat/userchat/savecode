                final messages = snapshot.data!.docs;

                // Group messages by date
                Map<String, List<DocumentSnapshot>> groupedMessages = {};

                for (var message in messages) {
                  if (message['timestamp'] != null) {
                    DateTime messageDate = message['timestamp'].toDate();
                    String formattedDate =
                        DateFormat('yyyy-MM-dd').format(messageDate);

                    if (!groupedMessages.containsKey(formattedDate)) {
                      groupedMessages[formattedDate] = [];
                    }
                    groupedMessages[formattedDate]!.add(message);
                  } else {
                    // Handle the case where 'timestamp' is null, if necessary
                    print('Timestamp is null for message: $message');
                  }
                }

                // Get today's date for comparison
                String todayKey =
                    DateFormat('yyyy-MM-dd').format(DateTime.now());
                int currentYear = DateTime.now().year;

                return ListView.builder(
                  physics: const BouncingScrollPhysics(),
                  itemCount: groupedMessages.keys.length,
                  itemBuilder: (context, index) {
                    String dateKey = groupedMessages.keys.elementAt(index);
                    List<DocumentSnapshot> dateMessages =
                        groupedMessages[dateKey]!;

